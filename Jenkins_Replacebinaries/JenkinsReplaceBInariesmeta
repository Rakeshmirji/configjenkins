import groovy.json.*

def CWA_values_map = readJSON text: CWA_values

def toJson(map) {
    return "{ " + map.collect { k, v -> "\"${k}\": \"${v}\"" }.join(", ") + " }"
}

def configMap = [
    CWA_values: CWA_values_map
]

pipeline {
    agent { label TestNode }

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Branch name to build')
        string(name: 'ENVIRONMENT', defaultValue: 'dev', description: 'Environment to deploy to')
        string(name: 'Timeout', defaultValue: '1000', description: 'Timeout for the Test stage (in seconds)')
        string(name: 'ctxentryprotectv2_download_link_branch', defaultValue: 'https://use-repo.citrite.net/artifactory/sesbld-virtual-releases/Jenkins/sesbuild-cwa-jm/sen/ctx-entryprotect-v2/ctx-master/278/ctx-entryprotect-v2.zip', description: 'Timeout for the Test stage (in seconds)')
        string(name: 'branch_from', defaultValue: 'ctx-master', description: 'branch to be created from')
        string(name: 'branch_to', defaultValue: 'ctx-master', description: 'Release branching target branch. Example input: ctx-release-2303')
        string(name: 'version_commit_jira', defaultValue: 'APPP-jiranumber', description: 'Version update commit Jira ID. for Example input: APPP-2026')
        string(name: 'SetTestSigning', defaultValue: 'False', description: 'Set Test Signing')
        string(name: 'Rebootbeforeexecution', defaultValue: 'False', description: 'Reboot before execution')
    }

    stages {
        stage('Test Signing') {
            steps {
                script {
                    if (params.Rebootbeforeexecution == "True") {

                        // def SetTestSigningvalue = ["SetTestSigning": "False"]
                        // configMap << SetTestSigningvalue
                        // def jsonConfigString = JsonOutput.toJson(configMap)
                        // def jsonConfig = readJSON text: jsonConfigString
                        // def configPath = "${env.WORKSPACE}/Automation/CWA_Automation/CWA_Automation/flows/config/Automation.json"
                        // writeJSON(file: configPath, json: jsonConfig, pretty: 4)
                        
                        // Reboot the machine
                        if (params.SetTestSigning == "True") {
                            bat 'bcdedit -set testsigning on'
                        }
                         if (params.SetTestSigning == "False") {
                            bat 'bcdedit -set testsigning on'
                        }
                        bat 'shutdown /r /f'
                        echo "Waiting for VM to reboot ${env.NODE_NAME}"
                        def count = 1
                        while (count <= 50) {
                            sleep(time: 5, unit: 'SECONDS')
                            if (!(nodesByLabel("${env.NODE_NAME}").size() > 0)) {
                                break
                            }
                            count++
                        }
                        echo "Waiting for VM to connect"
                        count = 1
                      while (count <= 100) {
                        sleep(time: 5, unit: 'SECONDS')
                        if (nodesByLabel("${env.NODE_NAME}").size() > 0) {
                            if (params.SetTestSigning == "True") {
                            def output = bat(script: 'bcdedit /enum | findstr /i "testsigning"', returnStdout: true).trim()
                            echo "Test Signing status: ${output}"
                            if (output.contains('Yes')) {
                                echo 'Test Signing is enabled'
                            } else {
                                echo 'Test Signing is disabled'
                                error 'Test Signing is not enabled'
                                exit 1
                            }
                            }
                            break
                        }
                        count++
                    }
                    }
                }
            }
        }
    }
}